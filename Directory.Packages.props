<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Platform -->
    <PackageVersion Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1" />

    <!-- App: MVVM + composition root (ARCHITECTURE §3) -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />

    <!-- Data: SQLite + explicit SQL (ARCHITECTURE §3). Microsoft.Data.Sqlite bundles e_sqlite3 with FTS5. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Dapper" Version="2.1.89" />

    <!-- Logging: abstractions everywhere, own redacting file sink (Platform.Windows). -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />

    <!-- Tests -->
    <!-- Tests run on Microsoft.Testing.Platform (see global.json), so no VSTest adapter is needed. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- FakeTimeProvider: timers fire on Advance(), so the reminder scheduler is tested without waiting. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
  </ItemGroup>
</Project>
