<Project Sdk="Microsoft.NET.Sdk">

  <!-- Persistence: SQLite, migrations, backup/restore, import/export. Depends only on Core. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Migrations ship inside the assembly: the exe can never run against a missing or edited script. -->
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="FinanceOS.Data.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FinanceOS.Data.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinanceOS.Core\FinanceOS.Core.csproj" />
  </ItemGroup>

</Project>
