<!--
  Views for the shell's pages, picked by ViewModel type (implicit DataTemplates).
  Merged into App.xaml after the design system, so every style and icon is available.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:FinanceOS.UI.Controls;assembly=FinanceOS.UI"
                    xmlns:shell="clr-namespace:FinanceOS.App.Shell"
                    xmlns:tasks="clr-namespace:FinanceOS.App.Tasks"
                    xmlns:onboarding="clr-namespace:FinanceOS.App.Onboarding"
                    xmlns:loc="clr-namespace:FinanceOS.UI.Localization;assembly=FinanceOS.UI">

    <shell:IconKeyConverter x:Key="IconKey" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Page header shared by every page: title, optional badge, one-line subtitle. -->
    <DataTemplate x:Key="Page.Header" DataType="{x:Type shell:PageViewModel}">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Style="{StaticResource Text.Headline}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Subtitle}" />
        </StackPanel>
    </DataTemplate>

    <!-- Sections that arrive later: real empty state, clearly marked, no dead buttons. -->
    <DataTemplate DataType="{x:Type shell:ComingSoonPageViewModel}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Style="{StaticResource Text.Headline}" Text="{Binding Title}" />
                <ui:Badge Tone="Info" Content="{loc:Tr Common.ComingSoon}" Margin="12,4,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="{Binding Subtitle}" Margin="0,0,0,24" />
            <ui:Card>
                <ui:EmptyState Padding="24,56" Icon="{Binding Info.IconKey, Converter={StaticResource IconKey}}"
                               Title="{Binding EmptyTitle}" Description="{Binding EmptyDescription}" />
            </ui:Card>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type shell:SettingsPageViewModel}">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Page.Header}" />
            <ui:Card Header="{loc:Tr Settings.Mode.Header}" Margin="0,0,0,16" Description="{loc:Tr Settings.Mode.Description}"
                     Visibility="{Binding HasPreferences, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ComboBox Width="240" HorizontalAlignment="Left" ui:FieldAssist.Header="{loc:Tr Settings.Mode}" DisplayMemberPath="Label"
                              ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding ModeDescription}" />
                </StackPanel>
            </ui:Card>
            <ui:Card Header="{loc:Tr Settings.Appearance.Header}" Description="{loc:Tr Settings.Appearance.Description}">
                <WrapPanel>
                    <ComboBox Width="240" Margin="0,0,24,0" ui:FieldAssist.Header="{loc:Tr Settings.Theme}" DisplayMemberPath="Label"
                              ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" />
                    <ComboBox Width="240" ui:FieldAssist.Header="{loc:Tr Settings.Accent}" DisplayMemberPath="Label"
                              ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent}" />
                </WrapPanel>
            </ui:Card>
            <ui:Card Header="{loc:Tr Settings.Language.Header}" Margin="0,16,0,0" Description="{loc:Tr Settings.Language.Description}">
                <WrapPanel>
                    <ComboBox Width="240" Margin="0,0,24,0" ui:FieldAssist.Header="{loc:Tr Settings.Language}" DisplayMemberPath="Label"
                              ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" />
                    <ComboBox Width="240" ui:FieldAssist.Header="{loc:Tr Settings.DateFormat}" DisplayMemberPath="Label"
                              ItemsSource="{Binding DateFormatOptions}" SelectedItem="{Binding SelectedDateFormat}"
                              Visibility="{Binding HasPreferences, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
            </ui:Card>
            <ui:Card Header="{loc:Tr Settings.Schedule.Header}" Margin="0,16,0,0" Description="{loc:Tr Settings.Schedule.Description}"
                     Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <WrapPanel>
                        <ui:TimePicker Width="160" Margin="0,0,16,12" ui:FieldAssist.Header="{loc:Tr Settings.WorkStart}" SelectedTime="{Binding WorkStart}" />
                        <ui:TimePicker Width="160" Margin="0,0,16,12" ui:FieldAssist.Header="{loc:Tr Settings.WorkEnd}" SelectedTime="{Binding WorkEnd}" />
                    </WrapPanel>
                    <CheckBox Style="{StaticResource Toggle}" Margin="0,4,0,12" Content="{loc:Tr Settings.Quiet.Toggle}" IsChecked="{Binding QuietEnabled}" />
                    <WrapPanel Visibility="{Binding QuietEnabled, Converter={StaticResource BoolToVisibility}}">
                        <ui:TimePicker Width="160" Margin="0,0,16,12" ui:FieldAssist.Header="{loc:Tr Settings.QuietStart}" SelectedTime="{Binding QuietStart}" />
                        <ui:TimePicker Width="160" Margin="0,0,16,12" ui:FieldAssist.Header="{loc:Tr Settings.QuietEnd}" SelectedTime="{Binding QuietEnd}" />
                        <CheckBox VerticalAlignment="Bottom" Margin="0,0,0,18" Content="{loc:Tr Settings.Quiet.Weekends}" IsChecked="{Binding QuietWeekends}" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>
            <ui:Card Header="{loc:Tr Settings.Startup.Header}" Margin="0,16,0,0" Description="{loc:Tr Settings.Startup.Description}"
                     Visibility="{Binding CanStartWithWindows, Converter={StaticResource BoolToVisibility}}">
                <CheckBox Style="{StaticResource Toggle}" Content="{loc:Tr Settings.Startup.Toggle}" IsChecked="{Binding StartWithWindows}" />
            </ui:Card>
            <ui:Card Header="{loc:Tr Settings.Data.Header}" Margin="0,16,0,0" Description="{loc:Tr Settings.Data.Description}">
                <StackPanel>
                    <TextBox ui:FieldAssist.Header="{loc:Tr Settings.Data.Folder}" IsReadOnly="True" Text="{Binding DataFolder, Mode=OneWay}"
                             ui:FieldAssist.HelperText="{loc:Tr Settings.Data.FolderHelp}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,16,0,0" TextWrapping="Wrap" Text="{Binding LastBackupText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding BackupNowCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:Icon Data="{StaticResource Icon.Archive}" Size="16" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Tr Settings.Data.BackupNow}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding OpenDataFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:Icon Data="{StaticResource Icon.Folder}" Size="16" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Tr Settings.Data.OpenFolder}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding BackupMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BackupFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BackupMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ui:Card>
            <ui:Card Header="{loc:Tr Settings.Demo.Header}" Margin="0,16,0,0" Description="{loc:Tr Settings.Demo.Description}"
                     Visibility="{Binding HasDemoData, Converter={StaticResource BoolToVisibility}}">
                <Button HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}" Content="{loc:Tr Settings.Demo.Remove}"
                        Command="{Binding RemoveDemoDataCommand}" />
            </ui:Card>
            <ui:Card Header="{loc:Tr Settings.About.Header}" Margin="0,16,0,0" Description="{loc:Tr Settings.About.Description}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}">
                        <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="–" />
                        <Run Text="{Binding AuthorRole, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap">
                        <Run Text="{loc:Tr Settings.About.Contact}" />
                        <Run Text="{Binding ContactEmail, Mode=OneWay}" Foreground="{DynamicResource Brush.TextPrimary}" /><Run Text="." />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding SendFeedbackCommand}"
                                ToolTip="{loc:Tr Settings.About.FeedbackToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:Icon Data="{StaticResource Icon.Pencil}" Size="16" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Tr Settings.About.Feedback}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,16,0,0">
                        <Run Text="{loc:Tr Settings.About.Version}" />
                        <Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding CopyrightText}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================ Tasks (M7) -->

    <!-- View tabs: a row of pills with counts. -->
    <Style x:Key="Tasks.Tab" TargetType="ListBoxItem" BasedOn="{StaticResource ListRow.Base}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Pill" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Medium}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Brush.Surface}" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Tasks.TabTemplate" DataType="{x:Type tasks:TaskViewTab}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
            <TextBlock Margin="6,0,0,0" Opacity="0.7" Text="{Binding Count}" />
        </StackPanel>
    </DataTemplate>

    <!-- One task in the list: hover and selection like the sidebar, focus ring for the keyboard. -->
    <Style x:Key="Tasks.Row" TargetType="ListBoxItem" BasedOn="{StaticResource ListRow.Base}">
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Medium}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SubtleSelected}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tasks.Meta" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="Tasks.RowTemplate" DataType="{x:Type tasks:TaskRowViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox VerticalAlignment="Top" Margin="0,1,12,0" Focusable="False"
                      IsChecked="{Binding IsClosed, Mode=OneWay}" AutomationProperties.Name="{loc:Tr Tasks.Row.Complete}"
                      Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <WrapPanel Margin="0,3,0,0">
                    <TextBlock Text="{Binding DueLabel}" Visibility="{Binding DueLabel, Converter={x:Static shell:Converters.NullToCollapsed}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Tasks.Meta}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Due}" Value="Today">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Due}" Value="Overdue">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Tasks.Meta}" Visibility="{Binding ParentTitle, Converter={x:Static shell:Converters.NullToCollapsed}}">
                        <Run Text="↳ " /><Run Text="{Binding ParentTitle, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Tasks.Meta}" Text="{Binding Context}" Visibility="{Binding Context, Converter={x:Static shell:Converters.NullToCollapsed}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" Visibility="{Binding ChecklistProgress, Converter={x:Static shell:Converters.NullToCollapsed}}">
                        <ui:Icon Data="{StaticResource Icon.ListChecks}" Size="12" Margin="0,0,4,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ChecklistProgress}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Tasks.Meta}" Margin="0,0,8,0" Foreground="{DynamicResource Brush.AccentText}">
                                    <Run Text="#" /><Run Text="{Binding Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,1,0,0">
                <ui:Badge Tone="Neutral" Margin="0,0,8,0" Content="{loc:Tr Tasks.Row.Demo}" Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}" />
                <ui:Icon Data="{StaticResource Icon.Pin}" Size="14" Margin="0,2,8,0" Foreground="{DynamicResource Brush.TextSecondary}"
                         Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{loc:Tr Tasks.Row.Pinned}" />
                <ui:Badge Content="{Binding PriorityLabel}" Visibility="{Binding PriorityLabel, Converter={x:Static shell:Converters.NullToCollapsed}}">
                    <ui:Badge.Style>
                        <Style TargetType="ui:Badge" BasedOn="{StaticResource {x:Type ui:Badge}}">
                            <Setter Property="Tone" Value="Warning" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                    <Setter Property="Tone" Value="Danger" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Badge.Style>
                </ui:Badge>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tasks:TasksPageViewModel}">
        <DockPanel>
            <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource Page.Header}" />

            <TextBox DockPanel.Dock="Top" FontSize="{StaticResource FontSize.Subheading}" MinHeight="44"
                     Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}"
                     ui:FieldAssist.Placeholder="{loc:Tr Tasks.QuickAdd.Placeholder}"
                     AutomationProperties.Name="{loc:Tr Tasks.QuickAdd.Name}"
                     shell:FocusRequest.Token="{Binding QuickAddFocusToken}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding AddTaskCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <DockPanel DockPanel.Dock="Top" Margin="0,16,0,8" LastChildFill="False">
                <ComboBox DockPanel.Dock="Right" Width="180" VerticalAlignment="Center" DisplayMemberPath="Label"
                          ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                          AutomationProperties.Name="{loc:Tr Tasks.Sort}" ToolTip="{loc:Tr Tasks.Sort}" />
                <ListBox DockPanel.Dock="Left" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                         ItemContainerStyle="{StaticResource Tasks.Tab}" ItemTemplate="{StaticResource Tasks.TabTemplate}"
                         Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="{loc:Tr Tasks.Views}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </DockPanel>

            <Grid>
                <!-- Virtualized: only the visible rows exist, so thousands of tasks scroll smoothly. -->
                <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                         ItemContainerStyle="{StaticResource Tasks.Row}" ItemTemplate="{StaticResource Tasks.RowTemplate}"
                         Background="Transparent" BorderThickness="0" Padding="0" Margin="-12,0,-12,0"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{loc:Tr Tasks.List}"
                         Visibility="{Binding IsEmpty, Converter={x:Static shell:Converters.TrueToCollapsed}}">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
                        <KeyBinding Gesture="Ctrl+Return" Command="{Binding ToggleCompleteSelectedCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
                    </ListBox.InputBindings>
                </ListBox>
                <ui:Card VerticalAlignment="Top" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <ui:EmptyState Padding="24,48" Icon="{StaticResource Icon.ListChecks}" Title="{Binding EmptyTitle}" Description="{Binding EmptyDescription}" />
                </ui:Card>
            </Grid>
        </DockPanel>
    </DataTemplate>

    <!-- Section label inside the details panel. -->
    <Style x:Key="Details.Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Overline}">
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>

    <DataTemplate DataType="{x:Type tasks:TaskDetailsViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="20,16,20,24">
                <!-- Subtask: back to the parent. -->
                <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-12,-4,0,8" Command="{Binding OpenParentCommand}"
                        Visibility="{Binding IsSubtask, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:Icon Data="{StaticResource Icon.ChevronLeft}" Size="14" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:Tr Details.Parent}" Margin="0,0,4,0" />
                        <TextBlock Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Text="{Binding ParentTitle}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                    </StackPanel>
                </Button>

                <Border Margin="0,0,0,12" Padding="12,8" CornerRadius="{StaticResource Radius.Medium}" Background="{DynamicResource Brush.InfoSubtle}"
                        Visibility="{Binding IsArchived, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.InfoText}" Text="{loc:Tr Details.Archived}" />
                </Border>

                <TextBox FontSize="{StaticResource FontSize.Subheading}" FontWeight="SemiBold" TextWrapping="Wrap"
                         ui:FieldAssist.Header="{loc:Tr Details.Title}" ui:FieldAssist.ErrorText="{Binding Errors[Title]}"
                         shell:EnterCommits.IsEnabled="True" Text="{Binding Title}" />

                <!-- Main actions. -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding ToggleCompleteCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{StaticResource Icon.Check}" Size="16" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CompleteLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Margin="8,0,0,0" Command="{Binding TogglePinCommand}"
                            ToolTip="{Binding PinLabel}" AutomationProperties.Name="{Binding PinLabel}">
                        <ui:Icon Data="{StaticResource Icon.Pin}" Size="16" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding DuplicateCommand}"
                            ToolTip="{loc:Tr Details.Duplicate}" AutomationProperties.Name="{loc:Tr Details.Duplicate}">
                        <ui:Icon Data="{StaticResource Icon.Copy}" Size="16" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding ToggleArchiveCommand}"
                            ToolTip="{Binding ArchiveLabel}" AutomationProperties.Name="{Binding ArchiveLabel}">
                        <ui:Icon Data="{StaticResource Icon.Archive}" Size="16" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding DeleteCommand}"
                            ToolTip="{loc:Tr Details.Delete}" AutomationProperties.Name="{loc:Tr Details.Delete}">
                        <ui:Icon Data="{StaticResource Icon.Trash}" Size="16" Foreground="{DynamicResource Brush.DangerText}" />
                    </Button>
                </StackPanel>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox Margin="0,0,0,12" ui:FieldAssist.Header="{loc:Tr Details.Status}" DisplayMemberPath="Label"
                              ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" />
                    <ComboBox Grid.Column="2" Margin="0,0,0,12" ui:FieldAssist.Header="{loc:Tr Details.Priority}" DisplayMemberPath="Label"
                              ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding SelectedPriority}" />
                    <DatePicker Grid.Row="1" Margin="0,0,0,12" ui:FieldAssist.Header="{loc:Tr Details.DueDate}"
                                ui:FieldAssist.ErrorText="{Binding Errors[DueDate]}" SelectedDate="{Binding DueDate}" />
                    <ui:TimePicker Grid.Row="1" Grid.Column="2" Margin="0,0,0,12" ui:FieldAssist.Header="{loc:Tr Details.DueTime}"
                                   ui:FieldAssist.HelperText="{loc:Tr Details.DueTimeHint}" ui:FieldAssist.ErrorText="{Binding Errors[DueTime]}"
                                   SelectedTime="{Binding DueTime}" />
                    <ComboBox Grid.Row="2" ui:FieldAssist.Header="{loc:Tr Details.Category}" DisplayMemberPath="Label"
                              ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" />
                    <ComboBox Grid.Row="2" Grid.Column="2" ui:FieldAssist.Header="{loc:Tr Details.Project}" DisplayMemberPath="Label"
                              IsEnabled="{Binding AdvancedFields}" Visibility="{Binding ShowProject, Converter={StaticResource BoolToVisibility}}"
                              ItemsSource="{Binding ProjectOptions}" SelectedItem="{Binding SelectedProject}" />
                </Grid>

                <!-- Reminders -->
                <TextBlock Style="{StaticResource Details.Section}" Text="{loc:Tr Details.Reminders}" />
                <ItemsControl ItemsSource="{Binding ReminderRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type tasks:ReminderRowViewModel}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Icon Data="{StaticResource Icon.Bell}" Size="14" Margin="0,3,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Brush.TextSecondary}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding Label}" />
                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{Binding Next}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="24" Height="24" MinHeight="24" Padding="0" VerticalAlignment="Top"
                                        Command="{Binding DataContext.RemoveReminderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding RemoveLabel}" AutomationProperties.Name="{Binding RemoveLabel}">
                                    <ui:Icon Data="{StaticResource Icon.X}" Size="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ComboBox DisplayMemberPath="Label" ItemsSource="{Binding ReminderPresets}" SelectedItem="{Binding SelectedReminderPreset}"
                          ui:FieldAssist.Placeholder="{loc:Tr Details.AddReminder}" AutomationProperties.Name="{loc:Tr Details.AddReminder}"
                          ui:FieldAssist.ErrorText="{Binding Errors[Reminders]}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,6" Text="{loc:Tr Details.ReminderAt}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DatePicker SelectedDate="{Binding ReminderDate}" AutomationProperties.Name="{loc:Tr Details.ReminderDate}" />
                    <ui:TimePicker Grid.Column="2" SelectedTime="{Binding ReminderTime}" AutomationProperties.Name="{loc:Tr Details.ReminderTime}" />
                    <Button Grid.Column="4" Style="{StaticResource Button.Secondary}" VerticalAlignment="Top"
                            Content="{loc:Tr Details.AddReminderButton}" Command="{Binding AddAbsoluteReminderCommand}" />
                </Grid>

                <!-- Tags -->
                <TextBlock Style="{StaticResource Details.Section}" Text="{loc:Tr Details.Tags}" />
                <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type tasks:TagChip}">
                            <Border Margin="0,0,6,6" Padding="10,2,4,2" CornerRadius="12" Background="{DynamicResource Brush.AccentSubtle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center" Text="{Binding Name}" />
                                    <Button Style="{StaticResource Button.Icon}" Width="20" Height="20" MinHeight="20" Margin="4,0,0,0" Padding="0"
                                            Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding RemoveLabel}" AutomationProperties.Name="{Binding RemoveLabel}">
                                        <ui:Icon Data="{StaticResource Icon.X}" Size="12" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Text="{Binding NewTagText, UpdateSourceTrigger=PropertyChanged}" ui:FieldAssist.Placeholder="{loc:Tr Details.AddTag}"
                         AutomationProperties.Name="{loc:Tr Details.AddTag}" ui:FieldAssist.ErrorText="{Binding Errors[Tags]}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddTagCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Description -->
                <TextBox Margin="0,20,0,0" Style="{StaticResource TextBox.Multiline}" MinHeight="72"
                         ui:FieldAssist.Header="{loc:Tr Details.Description}" ui:FieldAssist.ErrorText="{Binding Errors[Description]}"
                         Text="{Binding Description}" />

                <!-- Checklist -->
                <TextBlock Style="{StaticResource Details.Section}" Text="{loc:Tr Details.Checklist}" />
                <ItemsControl ItemsSource="{Binding Checklist}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type tasks:ChecklistRowViewModel}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="{Binding IsDone}" AutomationProperties.Name="{Binding Text}" />
                                <TextBox Grid.Column="1" Style="{StaticResource TextBox.Bare}" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Body}"
                                         shell:EnterCommits.IsEnabled="True" Text="{Binding Text}" AutomationProperties.Name="{Binding Text}" />
                                <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="24" Height="24" MinHeight="24" Padding="0"
                                        Command="{Binding DataContext.RemoveChecklistItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" ToolTip="{loc:Tr Details.RemoveChecklistItem}"
                                        AutomationProperties.Name="{loc:Tr Details.RemoveChecklistItem}">
                                    <ui:Icon Data="{StaticResource Icon.X}" Size="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Text="{Binding NewChecklistText, UpdateSourceTrigger=PropertyChanged}" ui:FieldAssist.Placeholder="{loc:Tr Details.AddChecklistItem}"
                         AutomationProperties.Name="{loc:Tr Details.AddChecklistItem}" ui:FieldAssist.ErrorText="{Binding Errors[Checklist]}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddChecklistItemCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Subtasks (top-level tasks only) -->
                <StackPanel Visibility="{Binding CanHaveSubtasks, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Details.Section}" Text="{loc:Tr Details.Subtasks}" />
                    <ItemsControl ItemsSource="{Binding Subtasks}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type tasks:SubtaskRowViewModel}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="{Binding IsClosed}" AutomationProperties.Name="{Binding Title}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                    <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="24" Height="24" MinHeight="24" Padding="0"
                                            Command="{Binding OpenCommand}" ToolTip="{Binding OpenLabel}" AutomationProperties.Name="{Binding OpenLabel}">
                                        <ui:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding NewSubtaskText, UpdateSourceTrigger=PropertyChanged}" ui:FieldAssist.Placeholder="{loc:Tr Details.AddSubtask}"
                             AutomationProperties.Name="{loc:Tr Details.AddSubtask}" ui:FieldAssist.ErrorText="{Binding Errors[Subtasks]}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddSubtaskCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <!-- People and references (Simple mode: only when filled in, read-only) -->
                <StackPanel Visibility="{Binding ShowReferences, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource Details.Section}" Text="{loc:Tr Details.References}" />
                <TextBox Margin="0,0,0,12" ui:FieldAssist.Header="{loc:Tr Details.Requester}" ui:FieldAssist.ErrorText="{Binding Errors[Requester]}"
                         shell:EnterCommits.IsEnabled="True" IsReadOnly="{Binding ReferencesReadOnly}" Text="{Binding Requester}" />
                <TextBox Margin="0,0,0,12" ui:FieldAssist.Header="{loc:Tr Details.Responsible}" ui:FieldAssist.ErrorText="{Binding Errors[Responsible]}"
                         shell:EnterCommits.IsEnabled="True" IsReadOnly="{Binding ReferencesReadOnly}" Text="{Binding Responsible}" />
                <TextBox Margin="0,0,0,12" ui:FieldAssist.Header="{loc:Tr Details.ExternalRef}" ui:FieldAssist.HelperText="{loc:Tr Details.ExternalRefHint}"
                         ui:FieldAssist.ErrorText="{Binding Errors[ExternalRef]}" shell:EnterCommits.IsEnabled="True" IsReadOnly="{Binding ReferencesReadOnly}" Text="{Binding ExternalRef}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox ui:FieldAssist.Header="{loc:Tr Details.ExternalUrl}" ui:FieldAssist.ErrorText="{Binding Errors[ExternalUrl]}"
                             shell:EnterCommits.IsEnabled="True" IsReadOnly="{Binding ReferencesReadOnly}" Text="{Binding ExternalUrl}" />
                    <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Margin="6,0,0,0" VerticalAlignment="Bottom"
                            Command="{Binding OpenLinkCommand}" ToolTip="{loc:Tr Details.OpenLink}" AutomationProperties.Name="{loc:Tr Details.OpenLink}">
                        <ui:Icon Data="{StaticResource Icon.ExternalLink}" Size="16" />
                    </Button>
                </Grid>
                </StackPanel>

                <!-- Notes -->
                <TextBox Margin="0,20,0,0" Style="{StaticResource TextBox.Multiline}" MinHeight="72"
                         ui:FieldAssist.Header="{loc:Tr Details.Notes}" ui:FieldAssist.ErrorText="{Binding Errors[Notes]}"
                         Text="{Binding Notes}" />

                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,20,0,0" TextWrapping="Wrap" Text="{Binding Meta}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ============================================================ My Day + Overview (M8): after the Tasks templates they reuse. -->

    <!-- A task row as a button (Overview): click or Enter opens it in the details panel. -->
    <Style x:Key="Tasks.RowButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="-12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Medium}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SubtleSelected}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type tasks:OverviewPageViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Display}" Text="{Binding Greeting}" />
            <!-- The date is already in the title bar on every page. -->
            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="{StaticResource FontSize.Subheading}" LineHeight="24"
                       Margin="0,4,0,28" Text="{Binding Subtitle}" />

            <!-- Summary. Right margin -16 cancels the gap after the last tile. -->
            <ItemsControl ItemsSource="{Binding Stats}" Margin="0,0,-16,24" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type tasks:StatTile}">
                        <Border Margin="0,0,16,0" Padding="20,16" CornerRadius="{StaticResource Radius.Large}"
                                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Label}" />
                                <TextBlock FontSize="{StaticResource FontSize.Headline}" LineHeight="32" FontWeight="SemiBold" Margin="0,6,0,2" Text="{Binding Value}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Numeric}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Hint}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Card Header="{loc:Tr Overview.Top3.Header}" Description="{loc:Tr Overview.Top3.Description}">
                    <Grid>
                        <ui:EmptyState Padding="16,28" Icon="{StaticResource Icon.Flag}" Title="{loc:Tr Overview.Top3.EmptyTitle}"
                                       Description="{loc:Tr Overview.Top3.EmptyDescription}"
                                       Visibility="{Binding IsTopEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Top}" Focusable="False" AutomationProperties.Name="{loc:Tr Overview.Top3.List}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type tasks:TaskRowViewModel}">
                                    <Button Style="{StaticResource Tasks.RowButton}" AutomationProperties.Name="{Binding Title}"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Tasks.RowTemplate}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ui:Card>
                <ui:Card Grid.Column="2" Header="{loc:Tr Overview.Today.Header}" Description="{loc:Tr Overview.Today.Description}">
                    <Grid>
                        <ui:EmptyState Padding="16,28" Icon="{StaticResource Icon.Clock}" Title="{loc:Tr Overview.Today.EmptyTitle}"
                                       Description="{loc:Tr Overview.Today.EmptyDescription}"
                                       Visibility="{Binding IsTimelineEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Timeline}" Focusable="False" AutomationProperties.Name="{loc:Tr Overview.Today.List}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type tasks:TimelineEntry}">
                                    <!-- Time above the task, so the row keeps the full card width (also with the side panel open). -->
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource Brush.AccentText}" Text="{Binding Time}" />
                                        <Button Style="{StaticResource Tasks.RowButton}" Margin="-12,0,-12,0"
                                                AutomationProperties.Name="{Binding Row.Title}"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Row}">
                                            <ContentPresenter Content="{Binding Row}" ContentTemplate="{StaticResource Tasks.RowTemplate}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ui:Card>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tasks:MyDayPageViewModel}">
        <DockPanel>
            <DockPanel.Resources>
                <!-- One list, grouped Overdue / Today / Tomorrow (rows arrive in that order). -->
                <CollectionViewSource x:Key="MyDayRows" Source="{Binding Rows}">
                    <CollectionViewSource.GroupDescriptions>
                        <PropertyGroupDescription PropertyName="Group" />
                    </CollectionViewSource.GroupDescriptions>
                </CollectionViewSource>
            </DockPanel.Resources>
            <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource Page.Header}" Margin="0,0,0,-12" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" Foreground="{DynamicResource Brush.SuccessText}"
                       FontWeight="SemiBold" Text="{Binding DoneTodayText}"
                       Visibility="{Binding DoneTodayText, Converter={x:Static shell:Converters.NullToCollapsed}}" />
            <Grid Margin="0,12,0,0">
                <ListBox ItemsSource="{Binding Source={StaticResource MyDayRows}}" SelectedItem="{Binding SelectedRow}"
                         ItemContainerStyle="{StaticResource Tasks.Row}" ItemTemplate="{StaticResource Tasks.RowTemplate}"
                         Background="Transparent" BorderThickness="0" Padding="0" Margin="-12,0,-12,0"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Tr MyDay.List}"
                         Visibility="{Binding IsEmpty, Converter={x:Static shell:Converters.TrueToCollapsed}}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="12,18,0,6">
                                        <TextBlock Style="{StaticResource Text.Overline}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Text.Overline}" Margin="8,0,0,0" Opacity="0.6" Text="{Binding ItemCount}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
                        <KeyBinding Gesture="Ctrl+Return" Command="{Binding ToggleCompleteSelectedCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
                    </ListBox.InputBindings>
                </ListBox>
                <ui:Card VerticalAlignment="Top" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <ui:EmptyState Padding="24,48" Icon="{StaticResource Icon.Sun}" Title="{Binding EmptyTitle}" Description="{Binding EmptyDescription}" />
                </ui:Card>
            </Grid>
        </DockPanel>
    </DataTemplate>


    <!-- ============================================================ Calendar (M11a) -->

    <DataTemplate x:Key="Calendar.Chip" DataType="{x:Type tasks:TaskRowViewModel}">
        <Button Margin="0,0,0,2" Padding="6,1" Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{Binding Title}" shell:TaskDrag.TaskId="{Binding Id}"
                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                CommandParameter="{Binding}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chip" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="{DynamicResource Brush.AccentSubtle}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.SubtleSelected}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.SubtleSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <TextBlock FontSize="{StaticResource FontSize.Caption}" TextTrimming="CharacterEllipsis" Text="{Binding Title}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Due}" Value="Overdue">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                <Setter Property="TextDecorations" Value="Strikethrough" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>
    </DataTemplate>

    <DataTemplate DataType="{x:Type tasks:CalendarPageViewModel}">
        <DockPanel>
            <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource Page.Header}" Margin="0,0,0,-8" />

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Title}" VerticalAlignment="Center" MinWidth="200" Text="{Binding PeriodTitle}"
                           Visibility="{Binding HasPeriod, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,0" Visibility="{Binding HasPeriod, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding PreviousCommand}" ToolTip="{loc:Tr Calendar.Previous}" AutomationProperties.Name="{loc:Tr Calendar.Previous}">
                        <ui:Icon Data="{StaticResource Icon.ChevronLeft}" Size="16" />
                    </Button>
                    <Button Style="{StaticResource Button.Secondary}" Margin="4,0" Content="{loc:Tr Calendar.Today}" Command="{Binding GoToTodayCommand}" />
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding NextCommand}" ToolTip="{loc:Tr Calendar.Next}" AutomationProperties.Name="{loc:Tr Calendar.Next}">
                        <ui:Icon Data="{StaticResource Icon.ChevronRight}" Size="16" />
                    </Button>
                </StackPanel>
                <ListBox DockPanel.Dock="Right" ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label"
                         ItemContainerStyle="{StaticResource Tasks.Tab}" Background="Transparent" BorderThickness="0" Padding="0"
                         AutomationProperties.Name="{loc:Tr Calendar.Views}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </DockPanel>

            <!-- Move confirmation: the due date changes only after "Move". -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="16,10" CornerRadius="{StaticResource Radius.Medium}"
                    Background="{DynamicResource Brush.WarningSubtle}" Visibility="{Binding MoveQuestion, Converter={x:Static shell:Converters.NullToCollapsed}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Primary}" Content="{loc:Tr Calendar.Move.Confirm}" Command="{Binding ConfirmMoveCommand}" />
                        <Button Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Content="{loc:Tr Common.Cancel}" Command="{Binding CancelMoveCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding MoveQuestion}" />
                </DockPanel>
            </Border>

            <Grid>
                <DockPanel Visibility="{Binding IsMonth, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Text="{loc:Tr Calendar.Move.Hint}" />
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding WeekdayNames}" Focusable="False" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Text.Overline}" Margin="8,0" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Days}" Focusable="False" AutomationProperties.Name="{loc:Tr Calendar.Grid}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="6" Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type tasks:CalendarDayViewModel}">
                                <Border Margin="0,0,-1,-1" Padding="6,4" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" ClipToBounds="True"
                                        AutomationProperties.Name="{Binding Name}"
                                        shell:TaskDrag.DropCommand="{Binding DataContext.RequestMoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        shell:TaskDrag.DropDate="{Binding Date}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top">
                                            <Border DockPanel.Dock="Left" MinWidth="22" Height="22" CornerRadius="11" Padding="4,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontWeight="SemiBold" FontSize="{StaticResource FontSize.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding DayNumber}" />
                                            </Border>
                                            <TextBlock Style="{StaticResource Text.Caption}" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Brush.DangerText}" Text="{Binding Holiday}" ToolTip="{Binding Holiday}" />
                                        </DockPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" Text="{Binding More}"
                                                   Visibility="{Binding More, Converter={x:Static shell:Converters.NullToCollapsed}}" />
                                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource Calendar.Chip}" Focusable="False" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- Week: seven columns, tasks by time; drop a task on another day to move it (with confirmation). -->
                <ItemsControl ItemsSource="{Binding WeekDays}" Focusable="False" Visibility="{Binding IsWeek, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type tasks:WeekDayColumn}">
                            <Border Margin="0,0,-1,0" Padding="6,6" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" ClipToBounds="True"
                                    shell:TaskDrag.DropCommand="{Binding DataContext.RequestMoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    shell:TaskDrag.DropDate="{Binding Date}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <Button DockPanel.Dock="Top" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Padding="6,2" Margin="-6,0,0,0"
                                            Command="{Binding DataContext.OpenDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Date}"
                                            ToolTip="{loc:Tr Calendar.OpenDay}">
                                        <TextBlock Text="{Binding Header}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodyStrong}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap"
                                               Text="{Binding Holiday}" Visibility="{Binding Holiday, Converter={x:Static shell:Converters.NullToCollapsed}}" />
                                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Rows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type tasks:TimedRow}">
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Text="{Binding Time}" />
                                                    <ContentPresenter Content="{Binding Row}" ContentTemplate="{StaticResource Calendar.Chip}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Day: all-day tasks, then the hours; outside working hours shaded. -->
                <DockPanel Visibility="{Binding IsDay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Text="{Binding WorkingHoursText}" />
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding DayAllDay}" Focusable="False" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type tasks:TimedRow}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Time}" />
                                    <ContentPresenter Grid.Column="1" Content="{Binding Row}" ContentTemplate="{StaticResource Calendar.Chip}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding DayHours}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type tasks:HourSlot}">
                                    <Border MinHeight="40" Padding="0,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Text.Caption}" Margin="8,0,0,0" Text="{Binding Label}" />
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource Calendar.Chip}" Focusable="False" Margin="0,0,8,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <Grid Visibility="{Binding IsAgenda, Converter={StaticResource BoolToVisibility}}">
                    <ui:Card VerticalAlignment="Top" Visibility="{Binding IsAgendaEmpty, Converter={StaticResource BoolToVisibility}}">
                        <ui:EmptyState Padding="24,48" Icon="{StaticResource Icon.Calendar}" Title="{loc:Tr Section.Calendar.EmptyTitle}" Description="{loc:Tr Calendar.Agenda.Empty}" />
                    </ui:Card>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Agenda}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type tasks:AgendaDay}">
                                    <StackPanel Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Style="{StaticResource Text.Overline}" Text="{Binding Label}" />
                                            <TextBlock Style="{StaticResource Text.Overline}" Margin="8,0,0,0" Foreground="{DynamicResource Brush.DangerText}" Text="{Binding Holiday}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type tasks:TaskRowViewModel}">
                                                    <Button Style="{StaticResource Tasks.RowButton}" AutomationProperties.Name="{Binding Title}"
                                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                            CommandParameter="{Binding}">
                                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Tasks.RowTemplate}" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </DockPanel>
    </DataTemplate>


    <!-- ============================================================ Onboarding (M12): first-run guide over the whole window. -->
    <Style x:Key="Onboarding.Choice" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Frame" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Large}" Padding="17,15">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Frame" Property="Padding" Value="16,14" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type onboarding:OnboardingViewModel}">
        <Grid Background="{DynamicResource Brush.Background}">
            <Border Width="600" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.XLarge}" Padding="32,28">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Caption}" Text="{Binding Progress}" />

                    <Grid DockPanel.Dock="Bottom" Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Left" Style="{StaticResource Button.Ghost}" Content="{loc:Tr Onboarding.Skip}" Command="{Binding SkipCommand}" />
                        <Button Grid.Column="1" Margin="0,0,8,0" Content="{loc:Tr Onboarding.Back}" Command="{Binding BackCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource Button.Primary}" IsDefault="True" Content="{Binding NextLabel}" Command="{Binding NextCommand}" />
                    </Grid>

                    <Grid MinHeight="300">
                        <!-- 1. Welcome and language -->
                        <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Text.Title}" Margin="0,8,0,8" TextWrapping="Wrap" Text="{loc:Tr Onboarding.Welcome.Title}" />
                            <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="{loc:Tr Onboarding.Welcome.Description}" />
                            <ComboBox Width="240" Margin="0,24,0,0" HorizontalAlignment="Left" ui:FieldAssist.Header="{loc:Tr Settings.Language}" DisplayMemberPath="Label"
                                      ItemsSource="{Binding Settings.LanguageOptions}" SelectedItem="{Binding Settings.SelectedLanguage}" />
                        </StackPanel>

                        <!-- 2. Simple or Advanced -->
                        <StackPanel Visibility="{Binding IsModeStep, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Text.Title}" Margin="0,8,0,8" TextWrapping="Wrap" Text="{loc:Tr Onboarding.Mode.Title}" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,20" TextWrapping="Wrap" Text="{loc:Tr Onboarding.Mode.Description}" />
                            <RadioButton Style="{StaticResource Onboarding.Choice}" GroupName="OnboardingMode" IsChecked="{Binding IsSimple}"
                                         AutomationProperties.Name="{loc:Tr Mode.Simple}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{loc:Tr Mode.Simple}" />
                                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{loc:Tr Onboarding.Mode.Simple.Description}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Onboarding.Choice}" GroupName="OnboardingMode" IsChecked="{Binding IsAdvanced}"
                                         AutomationProperties.Name="{loc:Tr Mode.Advanced}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{loc:Tr Mode.Advanced}" />
                                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{loc:Tr Onboarding.Mode.Advanced.Description}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- 3. Theme -->
                        <StackPanel Visibility="{Binding IsThemeStep, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Text.Title}" Margin="0,8,0,8" TextWrapping="Wrap" Text="{loc:Tr Onboarding.Theme.Title}" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,24" TextWrapping="Wrap" Text="{loc:Tr Onboarding.Theme.Description}" />
                            <WrapPanel>
                                <ComboBox Width="240" Margin="0,0,24,12" ui:FieldAssist.Header="{loc:Tr Settings.Theme}" DisplayMemberPath="Label"
                                          ItemsSource="{Binding Settings.ThemeOptions}" SelectedItem="{Binding Settings.SelectedTheme}" />
                                <ComboBox Width="240" Margin="0,0,0,12" ui:FieldAssist.Header="{loc:Tr Settings.Accent}" DisplayMemberPath="Label"
                                          ItemsSource="{Binding Settings.Accents}" SelectedItem="{Binding Settings.SelectedAccent}" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- 4. Working hours -->
                        <StackPanel Visibility="{Binding IsHoursStep, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Text.Title}" Margin="0,8,0,8" TextWrapping="Wrap" Text="{loc:Tr Onboarding.Hours.Title}" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,24" TextWrapping="Wrap" Text="{loc:Tr Onboarding.Hours.Description}" />
                            <WrapPanel>
                                <ui:TimePicker Width="160" Margin="0,0,16,12" ui:FieldAssist.Header="{loc:Tr Settings.WorkStart}" SelectedTime="{Binding Settings.WorkStart}" />
                                <ui:TimePicker Width="160" Margin="0,0,16,12" ui:FieldAssist.Header="{loc:Tr Settings.WorkEnd}" SelectedTime="{Binding Settings.WorkEnd}" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- 5. Notifications and sample data -->
                        <StackPanel Visibility="{Binding IsNotificationsStep, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Text.Title}" Margin="0,8,0,8" TextWrapping="Wrap" Text="{loc:Tr Onboarding.Notifications.Title}" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,0,0,20" TextWrapping="Wrap" Text="{loc:Tr Onboarding.Notifications.Description}" />
                            <CheckBox Style="{StaticResource Toggle}" Margin="0,0,0,12" Content="{loc:Tr Settings.Quiet.Toggle}" IsChecked="{Binding Settings.QuietEnabled}" />
                            <WrapPanel Visibility="{Binding Settings.QuietEnabled, Converter={StaticResource BoolToVisibility}}">
                                <ui:TimePicker Width="160" Margin="0,0,16,12" ui:FieldAssist.Header="{loc:Tr Settings.QuietStart}" SelectedTime="{Binding Settings.QuietStart}" />
                                <ui:TimePicker Width="160" Margin="0,0,16,12" ui:FieldAssist.Header="{loc:Tr Settings.QuietEnd}" SelectedTime="{Binding Settings.QuietEnd}" />
                            </WrapPanel>
                            <CheckBox Style="{StaticResource Toggle}" Margin="0,0,0,12" Content="{loc:Tr Settings.Startup.Toggle}" IsChecked="{Binding Settings.StartWithWindows}"
                                      Visibility="{Binding Settings.CanStartWithWindows, Converter={StaticResource BoolToVisibility}}" />
                            <CheckBox Margin="0,8,0,0" IsChecked="{Binding AddDemoData}">
                                <TextBlock TextWrapping="Wrap" Text="{loc:Tr Onboarding.Demo}" />
                            </CheckBox>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
