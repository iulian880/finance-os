<Window x:Class="FinanceOS.App.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FinanceOS.UI.Controls;assembly=FinanceOS.UI"
        xmlns:shell="clr-namespace:FinanceOS.App.Shell"
        xmlns:loc="clr-namespace:FinanceOS.UI.Localization;assembly=FinanceOS.UI"
        Title="Finance OS"
        Width="1280" Height="820" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.SurfaceSunken}"
        FontFamily="{StaticResource Font.Sans}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <!--
      Layout: sidebar and title bar sit on the window backdrop (Mica on Windows 11, solid elsewhere);
      the page sits on a "content layer" with a rounded top-left corner. Toasts and the command palette
      overlay the whole window.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Sidebar width follows the collapsed state. -->
        <Style x:Key="Sidebar" TargetType="Border">
            <Setter Property="Width" Value="236" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="Width" Value="68" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarItem" TargetType="ListBoxItem" BasedOn="{StaticResource Nav.Item}">
            <Setter Property="ui:NavAssist.GroupHeader" Value="{Binding GroupHeader}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="ToolTip" Value="{Binding Title}" />
            <Setter Property="ToolTipService.IsEnabled" Value="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="DockPanel.Dock" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFooter}" Value="True">
                    <Setter Property="DockPanel.Dock" Value="Bottom" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="SidebarItemTemplate" DataType="{x:Type shell:NavItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Icon Data="{Binding IconKey, Converter={StaticResource IconKey}}" Size="18" />
                <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}"
                           Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenPaletteCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewTaskCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:Section.Overview}" />
        <KeyBinding Gesture="Ctrl+D2" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:Section.MyDay}" />
        <KeyBinding Gesture="Ctrl+D3" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:Section.Tasks}" />
        <KeyBinding Gesture="Ctrl+D4" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:Section.Calendar}" />
        <KeyBinding Gesture="Ctrl+D5" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:Section.Reminders}" />
        <KeyBinding Gesture="Ctrl+D6" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:Section.Workflows}" />
        <KeyBinding Gesture="Ctrl+D7" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:Section.Projects}" />
        <KeyBinding Gesture="Ctrl+D8" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:Section.Analytics}" />
        <KeyBinding Gesture="Ctrl+D9" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:Section.Archive}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:Section.Settings}" />
    </Window.InputBindings>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border x:Name="Sidebar" Style="{StaticResource Sidebar}">
            <DockPanel Margin="10,0,10,10">
                <!-- Brand row: part of the draggable title area. -->
                <Grid DockPanel.Dock="Top" Height="48" Margin="2,0,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.Accent}">
                            <ui:Icon Data="{StaticResource Icon.Check}" Size="16" StrokeThickness="2.75" Foreground="{DynamicResource Brush.OnAccent}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Finance OS" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource Button.Chrome}" HorizontalAlignment="Left" Margin="2,8,0,0"
                        Command="{Binding ToggleSidebarCommand}" AutomationProperties.Name="{loc:Tr Shell.ToggleSidebar.Name}"
                        ToolTip="{loc:Tr Shell.ToggleSidebar.ToolTip}">
                    <ui:Icon Data="{StaticResource Icon.PanelLeft}" Size="18" />
                </Button>

                <ListBox x:Name="Navigation" Style="{StaticResource Nav.List}" ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}" ItemContainerStyle="{StaticResource SidebarItem}"
                         ItemTemplate="{StaticResource SidebarItemTemplate}" ui:NavAssist.IsCompact="{Binding IsSidebarCollapsed}"
                         AutomationProperties.Name="{loc:Tr Shell.Navigation}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Settings docks to the bottom; everything else stacks from the top. -->
                            <DockPanel LastChildFill="False" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Title bar + content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource Text.Secondary}" Margin="16,0,16,0" VerticalAlignment="Center" Text="{Binding TodayText}" />

                <Button Grid.Column="1" Width="380" Style="{StaticResource Button.SearchField}" Command="{Binding OpenPaletteCommand}" IsEnabled="{Binding CanUseShell}"
                        AutomationProperties.Name="{loc:Tr Shell.Search.Name}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Icon Data="{StaticResource Icon.Search}" Size="16" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{loc:Tr Shell.Search}" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Style="{StaticResource Keycap}">
                            <TextBlock Style="{StaticResource Keycap.Text}" Text="Ctrl K" />
                        </Border>
                    </Grid>
                </Button>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" IsEnabled="{Binding CanUseShell}">
                    <Button Style="{StaticResource Button.Chrome}" Command="{Binding ToggleThemeCommand}"
                            AutomationProperties.Name="{loc:Tr Shell.ToggleTheme.Name}" ToolTip="{loc:Tr Shell.ToggleTheme.ToolTip}">
                        <ui:Icon Data="{StaticResource Icon.Moon}" Size="18" />
                    </Button>
                    <ToggleButton Style="{StaticResource ToggleButton.Chrome}" Command="{Binding ToggleNotificationsCommand}"
                                  IsChecked="{Binding IsNotificationsPanelOpen, Mode=OneWay}"
                                  AutomationProperties.Name="{loc:Tr Shell.Notifications}" ToolTip="{loc:Tr Shell.Notifications}">
                        <Grid>
                            <ui:Icon Data="{StaticResource Icon.Bell}" Size="18" />
                            <!-- Unread reminders. -->
                            <Border MinWidth="16" Height="16" Padding="4,0" CornerRadius="8" Margin="0,-6,-9,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource Brush.Danger}"
                                    Visibility="{Binding Notifications.HasUnread, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnDanger}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Notifications.UnreadCount}" />
                            </Border>
                        </Grid>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToggleButton.Chrome}" Command="{Binding ToggleDetailsCommand}"
                                  IsChecked="{Binding IsDetailsPanelOpen, Mode=OneWay}"
                                  AutomationProperties.Name="{loc:Tr Shell.DetailsPanel}" ToolTip="{loc:Tr Shell.DetailsPanel}">
                        <ui:Icon Data="{StaticResource Icon.PanelLeft}" Size="18" RenderTransformOrigin="0.5,0.5">
                            <ui:Icon.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </ui:Icon.RenderTransform>
                        </ui:Icon>
                    </ToggleButton>
                </StackPanel>

                <!-- Windows 11 + Mica: Windows draws the native caption buttons here (Snap Layouts included) and
                     CaptionSpacer keeps them clear. Elsewhere: our own buttons. Chosen in ShellWindow.xaml.cs. -->
                <ui:CaptionButtons x:Name="Caption" Grid.Column="4" MinimizeText="{loc:Tr Ui.Minimize}" MaximizeText="{loc:Tr Ui.Maximize}"
                                RestoreText="{loc:Tr Ui.Restore}" CloseText="{loc:Tr Ui.Close}" />
                <Border x:Name="CaptionSpacer" Grid.Column="4" Width="0" />
            </Grid>

            <!-- Content layer -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1,1,0,0" CornerRadius="12,0,0,0" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Pages with their own virtualized list (Tasks) get the full height and scroll themselves. -->
                    <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage.ScrollsItself}" Value="True">
                                        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" Margin="40,32,40,40" MaxWidth="1120"
                                        Focusable="False" IsTabStop="False" />
                    </ScrollViewer>

                    <Border x:Name="RightPanel" Grid.Column="1" Width="380" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0"
                            Visibility="{Binding IsRightPanelOpen, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="56" Margin="20,0,12,0">
                                <TextBlock Style="{StaticResource Text.Subheading}" VerticalAlignment="Center" Text="{Binding RightPanelTitle}" />
                                <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Right" Command="{Binding CloseRightPanelCommand}"
                                        AutomationProperties.Name="{loc:Tr Shell.ClosePanel}" ToolTip="{loc:Tr Shell.ClosePanel}">
                                    <ui:Icon Data="{StaticResource Icon.X}" Size="16" />
                                </Button>
                            </Grid>
                            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Border}" />
                            <Grid>
                                <!-- Details: what the current page selected (a task), else an empty state. -->
                                <Grid Visibility="{Binding IsDetailsPanelOpen, Converter={StaticResource BoolToVisibility}}">
                                    <ContentControl Content="{Binding CurrentPage.Details}" Focusable="False" IsTabStop="False"
                                                    Visibility="{Binding CurrentPage.Details, Converter={x:Static shell:Converters.NullToCollapsed}}" />
                                    <ui:EmptyState Padding="24,64" VerticalAlignment="Top" Icon="{StaticResource Icon.ListChecks}"
                                                   Title="{loc:Tr Shell.DetailsEmpty.Title}"
                                                   Description="{loc:Tr Shell.DetailsEmpty.Description}"
                                                   Visibility="{Binding CurrentPage.Details, Converter={x:Static shell:Converters.NotNullToCollapsed}}" />
                                </Grid>
                                <!-- Notification center: every reminder that fired, newest first, even if Windows hid the toast. -->
                                <Grid Visibility="{Binding IsNotificationsPanelOpen, Converter={StaticResource BoolToVisibility}}">
                                    <ui:EmptyState Padding="24,64" VerticalAlignment="Top" Icon="{StaticResource Icon.Bell}"
                                                   Title="{loc:Tr Shell.NotificationsEmpty.Title}"
                                                   Description="{loc:Tr Shell.NotificationsEmpty.Description}"
                                                   Visibility="{Binding Notifications.IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                    <DockPanel DataContext="{Binding Notifications}"
                                               Visibility="{Binding IsEmpty, Converter={x:Static shell:Converters.TrueToCollapsed}}">
                                        <Button DockPanel.Dock="Top" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right" Margin="0,8,12,0"
                                                Content="{loc:Tr Notifications.MarkAllRead}" Command="{Binding MarkAllReadCommand}"
                                                Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                            <ItemsControl ItemsSource="{Binding Items}" Margin="12,8,12,16" Focusable="False" AutomationProperties.Name="{loc:Tr Notifications.List}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="{StaticResource Radius.Medium}"
                                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Margin="8,2,0,0" Text="{Binding Time}" />
                                                                    <TextBlock Style="{StaticResource Text.BodyStrong}" TextWrapping="Wrap" Text="{Binding Title}" />
                                                                </DockPanel>
                                                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Detail}" />
                                                                <WrapPanel Margin="-8,6,0,0">
                                                                    <Button Style="{StaticResource Button.Ghost}" Content="{loc:Tr Notifications.Open}" Command="{Binding OpenCommand}"
                                                                            Visibility="{Binding HasTask, Converter={StaticResource BoolToVisibility}}" />
                                                                    <Button Style="{StaticResource Button.Ghost}" Content="{loc:Tr Notifications.Done}" Command="{Binding DoneCommand}"
                                                                            Visibility="{Binding CanAct, Converter={StaticResource BoolToVisibility}}" />
                                                                    <Button Style="{StaticResource Button.Ghost}" shell:ClickOpensMenu.IsEnabled="True"
                                                                            Visibility="{Binding CanAct, Converter={StaticResource BoolToVisibility}}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{loc:Tr Notifications.Snooze}" />
                                                                            <ui:Icon Data="{StaticResource Icon.ChevronDown}" Size="12" Margin="6,0,0,0" />
                                                                        </StackPanel>
                                                                        <Button.ContextMenu>
                                                                            <ContextMenu ItemsSource="{Binding SnoozeOptions}">
                                                                                <ContextMenu.ItemContainerStyle>
                                                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                                        <Setter Property="Header" Value="{Binding Label}" />
                                                                                        <Setter Property="Command" Value="{Binding DataContext.SnoozeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                                                                    </Style>
                                                                                </ContextMenu.ItemContainerStyle>
                                                                            </ContextMenu>
                                                                        </Button.ContextMenu>
                                                                    </Button>
                                                                    <Button Style="{StaticResource Button.Ghost}" Content="{loc:Tr Notifications.Dismiss}" Command="{Binding DismissCommand}"
                                                                            Visibility="{Binding CanAct, Converter={StaticResource BoolToVisibility}}" />
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- First-run guide over the window below the title bar, which stays draggable with its caption
             buttons (null content: nothing drawn, clicks pass through). -->
        <ContentControl Grid.ColumnSpan="2" Margin="0,48,0,0" Focusable="False" Content="{Binding Onboarding}" />

        <!-- Overlays -->
        <ui:ToastHost x:Name="Toasts" Grid.ColumnSpan="2" />
        <ui:CommandPalette x:Name="Palette" Grid.ColumnSpan="2" IsOpen="{Binding IsPaletteOpen, Mode=TwoWay}"
                           Placeholder="{loc:Tr Shell.Palette.Placeholder}" EmptyText="{loc:Tr Shell.Palette.Empty}" />
    </Grid>
</Window>
