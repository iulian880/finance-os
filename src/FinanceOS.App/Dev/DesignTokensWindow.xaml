<Window x:Class="FinanceOS.App.Dev.DesignTokensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finance OS — Design tokens"
        Width="1180" Height="860" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{StaticResource Font.Sans}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <!-- Developer page (Debug builds only): every token rendered live, in the current theme and accent. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource Padding.Page}" MaxWidth="1100" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource Text.Overline}" Text="Finance OS · Design system · M1" />
            <TextBlock Style="{StaticResource Text.Display}" Text="Design tokens" Margin="0,4,0,4" />
            <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                       Text="Culori, tipografie, spațiere, raze și elevație. Tot ce e pe pagină vine din tokens și se schimbă live cu tema și accentul." />

            <!-- Theme + accent pickers -->
            <Border Margin="0,24,0,0" Padding="{StaticResource Padding.Card}" CornerRadius="{StaticResource Radius.Large}"
                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    Effect="{DynamicResource Effect.Elevation1}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Temă" Margin="0,0,0,8" />
                        <StackPanel x:Name="ThemeChips" Orientation="Horizontal" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Accent" Margin="0,0,0,8" />
                        <StackPanel x:Name="AccentDots" Orientation="Horizontal" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock x:Name="StateText" Style="{StaticResource Text.Caption}" Margin="4,8,0,0" />

            <!-- In context -->
            <TextBlock Style="{StaticResource Text.Overline}" Text="În context" Margin="0,40,0,12" />
            <WrapPanel>
                <Border Width="420" Margin="0,0,24,24" Padding="{StaticResource Padding.Card}" CornerRadius="{StaticResource Radius.Large}"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        Effect="{DynamicResource Effect.Elevation1}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource Text.Overline}" Text="Azi · 3 prioritare" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Mar, 4 nov" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Subheading}" Margin="0,12,0,4" TextWrapping="Wrap"
                                   Text="Verifică facturile intercompany în așteptare" />
                        <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                   Text="Lipsesc detaliile de la solicitant pentru 3 documente. Follow-up programat la 09:30." />
                        <WrapPanel Margin="0,16,0,0">
                            <Border CornerRadius="{StaticResource Radius.Full}" Padding="10,3" Margin="0,0,8,0" Background="{DynamicResource Brush.AccentSubtle}">
                                <TextBlock Style="{StaticResource Text.Caption}" FontWeight="Medium" Foreground="{DynamicResource Brush.AccentText}" Text="Intercompany" />
                            </Border>
                            <Border CornerRadius="{StaticResource Radius.Full}" Padding="10,3" Margin="0,0,8,0" Background="{DynamicResource Brush.WarningSubtle}">
                                <TextBlock Style="{StaticResource Text.Caption}" FontWeight="Medium" Foreground="{DynamicResource Brush.WarningText}" Text="În așteptare · 2 zile" />
                            </Border>
                            <Border CornerRadius="{StaticResource Radius.Full}" Padding="10,3" Background="{DynamicResource Brush.DangerSubtle}">
                                <TextBlock Style="{StaticResource Text.Caption}" FontWeight="Medium" Foreground="{DynamicResource Brush.DangerText}" Text="Scadent azi" />
                            </Border>
                        </WrapPanel>
                        <Border Height="1" Margin="0,20,0,16" Background="{DynamicResource Brush.Border}" />
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="Valoare totală" />
                                <TextBlock Style="{StaticResource Text.Numeric}" FontSize="{StaticResource FontSize.Title}" FontWeight="SemiBold" LineHeight="28" Text="128.400,00 EUR" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border CornerRadius="{StaticResource Radius.Medium}" Padding="{StaticResource Padding.Control}" Margin="0,0,8,0"
                                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
                                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Amână" />
                                </Border>
                                <Border CornerRadius="{StaticResource Radius.Medium}" Padding="{StaticResource Padding.Control}" Background="{DynamicResource Brush.Accent}">
                                    <TextBlock Style="{StaticResource Text.BodyStrong}" Foreground="{DynamicResource Brush.OnAccent}" Text="Marchează gata" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Width="300" Margin="0,0,24,24" Padding="{StaticResource Padding.Card}" CornerRadius="{StaticResource Radius.Large}"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        Effect="{DynamicResource Effect.Elevation1}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Overline}" Text="Sumar" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="16" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Numeric}" FontSize="{StaticResource FontSize.Headline}" LineHeight="32" FontWeight="SemiBold" Text="12" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="De făcut azi" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Text.Numeric}" FontSize="{StaticResource FontSize.Headline}" LineHeight="32" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" Text="3" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="Întârziate" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Style="{StaticResource Text.Numeric}" FontSize="{StaticResource FontSize.Headline}" LineHeight="32" FontWeight="SemiBold" Foreground="{DynamicResource Brush.WarningText}" Text="5" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="În așteptare" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Style="{StaticResource Text.Numeric}" FontSize="{StaticResource FontSize.Headline}" LineHeight="32" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SuccessText}" Text="18" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="Finalizate săpt." />
                            </StackPanel>
                        </Grid>
                        <!-- Focus ring sample -->
                        <Border Margin="0,20,0,0" CornerRadius="{StaticResource Radius.Medium}" BorderThickness="2" BorderBrush="{DynamicResource Brush.FocusRing}" Padding="2">
                            <Border CornerRadius="6" Padding="10,6" Background="{DynamicResource Brush.SurfaceSunken}">
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="Caută sau adaugă… (focus)" />
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Colors (generated) -->
            <TextBlock Style="{StaticResource Text.Overline}" Text="Culori · temă" Margin="0,24,0,12" />
            <WrapPanel x:Name="PaletteSwatches" />
            <TextBlock Style="{StaticResource Text.Overline}" Text="Culori · accent" Margin="0,24,0,12" />
            <WrapPanel x:Name="AccentSwatches" />

            <!-- Typography -->
            <TextBlock Style="{StaticResource Text.Overline}" Text="Tipografie · Inter" Margin="0,32,0,12" />
            <Border Padding="{StaticResource Padding.Card}" CornerRadius="{StaticResource Radius.Large}"
                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Display}" Text="Display 32 — Închidere de lună" />
                    <TextBlock Style="{StaticResource Text.Headline}" Text="Headline 24 — Facturi în așteptare" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Text.Title}" Text="Title 20 — Reconcilieri conturi" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Text.Subheading}" Text="Subheading 16 — Solicitare de follow-up" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Text.Body}" Text="Body 14 — Verifică detaliile necesare și trimite confirmarea către solicitant." Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Body strong 14 — Aprobare lipsă pentru 2 documente" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="Secondary 14 — Ultima modificare acum 12 minute" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Text.Small}" Text="Small 13 — Diacritice: ăâîșț ĂÂÎȘȚ · „ghilimele” · 1.234,56 €" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Caption 12 — Creat de tine · 4 nov 2026, 09:30" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Text.Overline}" Text="Overline 12 — Astăzi" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Numeric (tabular)" />
                            <TextBlock Style="{StaticResource Text.Numeric}" Text="1.111,10" />
                            <TextBlock Style="{StaticResource Text.Numeric}" Text="9.000,00" />
                            <TextBlock Style="{StaticResource Text.Numeric}" Text="  708,45" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Proporțional" />
                            <TextBlock Style="{StaticResource Text.Body}" Text="1.111,10" />
                            <TextBlock Style="{StaticResource Text.Body}" Text="9.000,00" />
                            <TextBlock Style="{StaticResource Text.Body}" Text="  708,45" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Spacing / radii / elevation (generated) -->
            <TextBlock Style="{StaticResource Text.Overline}" Text="Spațiere · grilă de 4 px" Margin="0,32,0,12" />
            <StackPanel x:Name="SpacingRows" />
            <TextBlock Style="{StaticResource Text.Overline}" Text="Raze și elevație" Margin="0,32,0,12" />
            <WrapPanel x:Name="ShapeSamples" />
        </StackPanel>
    </ScrollViewer>
</Window>
