<!--
  Design-system entry point. Merge this once in App.xaml, then call ThemeManager.Current.Initialize(app),
  which adds the theme-specific color dictionary.

  Control styles are implicit (keyed by type), so plain <Button>, <TextBox>, <ComboBox>, <CheckBox>,
  <DatePicker>, <ToolTip> pick them up. Variants: Button.Primary / Button.Secondary / Button.Ghost /
  Button.Danger / Button.Icon, TextBox.Multiline, Toggle (CheckBox). Custom controls: ui:TimePicker, ui:Badge.
  Field label, placeholder, helper and error text: ui:FieldAssist attached properties.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Tokens.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/Base.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/Button.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/TextBox.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/ComboBox.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/CheckBox.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/DatePicker.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/TimePicker.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/Badge.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/ToolTip.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/Card.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/Menu.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/Dialog.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/Toast.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/CommandPalette.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/Shell.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
