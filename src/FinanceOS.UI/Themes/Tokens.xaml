<!--
  Non-color design tokens. Colors, brushes and shadows are generated per theme by ThemeResources
  (Brush.*, Color.*, Effect.Elevation1..3) and must always be referenced with DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Typefaces -->
    <FontFamily x:Key="Font.Sans">pack://application:,,,/FinanceOS.UI;component/Fonts/#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <!-- Type scale (DIPs). Pair each size with its line height from Typography.xaml. -->
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Small">13</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Subheading">16</sys:Double>
    <sys:Double x:Key="FontSize.Title">20</sys:Double>
    <sys:Double x:Key="FontSize.Headline">24</sys:Double>
    <sys:Double x:Key="FontSize.Display">32</sys:Double>

    <!-- Spacing: 4 px grid -->
    <sys:Double x:Key="Space.2">2</sys:Double>
    <sys:Double x:Key="Space.4">4</sys:Double>
    <sys:Double x:Key="Space.8">8</sys:Double>
    <sys:Double x:Key="Space.12">12</sys:Double>
    <sys:Double x:Key="Space.16">16</sys:Double>
    <sys:Double x:Key="Space.20">20</sys:Double>
    <sys:Double x:Key="Space.24">24</sys:Double>
    <sys:Double x:Key="Space.32">32</sys:Double>
    <sys:Double x:Key="Space.40">40</sys:Double>
    <sys:Double x:Key="Space.48">48</sys:Double>

    <Thickness x:Key="Padding.Control">12,7,12,7</Thickness>
    <Thickness x:Key="Padding.Card">20</Thickness>
    <Thickness x:Key="Padding.Page">32,24,32,32</Thickness>

    <!-- Radii -->
    <CornerRadius x:Key="Radius.Small">6</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">8</CornerRadius>
    <CornerRadius x:Key="Radius.Large">12</CornerRadius>
    <CornerRadius x:Key="Radius.XLarge">16</CornerRadius>
    <CornerRadius x:Key="Radius.Full">999</CornerRadius>

    <!-- Strokes -->
    <Thickness x:Key="Stroke.Hairline">1</Thickness>
    <Thickness x:Key="Stroke.Focus">2</Thickness>

    <!-- Motion. Short and restrained; Motion helpers use 0 when ThemeManager.ReducedMotion is true. -->
    <Duration x:Key="Duration.Fast">0:0:0.12</Duration>
    <Duration x:Key="Duration.Normal">0:0:0.18</Duration>
    <Duration x:Key="Duration.Slow">0:0:0.26</Duration>
    <CubicEase x:Key="Ease.Standard" EasingMode="EaseOut" />
    <QuinticEase x:Key="Ease.Emphasized" EasingMode="EaseOut" />

</ResourceDictionary>
