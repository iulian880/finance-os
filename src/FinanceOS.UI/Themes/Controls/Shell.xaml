<!--
  Window chrome and navigation: ui:CaptionButtons, sidebar navigation (Nav.List / Nav.Item),
  chrome buttons (Button.Chrome, ToggleButton.Chrome) and the title-bar search field (Button.SearchField).
  Items on the title bar and sidebar sit on Mica (or its solid fallback), so they use the translucent
  SubtleHover / SubtleSelected fills instead of opaque surface colors.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:FinanceOS.UI.Controls"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Caption buttons use the Windows icon font, like native windows (Segoe Fluent Icons on 11, MDL2 on 10). -->
    <FontFamily x:Key="Font.CaptionGlyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource Font.CaptionGlyphs}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SubtleSelected}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Close is red on hover in every theme, as in Windows itself. -->
    <Style x:Key="CaptionButton.Close" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C42B1C" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#C83C31" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ui:CaptionButtons">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:CaptionButtons">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PART_Minimize" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                                ToolTip="{TemplateBinding MinimizeText}" AutomationProperties.Name="{TemplateBinding MinimizeText}" />
                        <Button x:Name="PART_Maximize" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                                AutomationProperties.Name="{TemplateBinding MaximizeText}" />
                        <Button x:Name="PART_Close" Style="{StaticResource CaptionButton.Close}" Content="&#xE8BB;"
                                ToolTip="{TemplateBinding CloseText}" AutomationProperties.Name="{TemplateBinding CloseText}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsWindowMaximized" Value="True">
                            <Setter TargetName="PART_Maximize" Property="Content" Value="&#xE923;" />
                            <Setter TargetName="PART_Maximize" Property="AutomationProperties.Name" Value="{Binding RestoreText, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <!-- The maximize button is hit-tested by Windows (Snap Layouts), so WPF never sees the mouse over it. -->
                        <Trigger Property="IsMaximizeHovered" Value="True">
                            <Setter TargetName="PART_Maximize" Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsMaximizePressed" Value="True">
                            <Setter TargetName="PART_Maximize" Property="Background" Value="{DynamicResource Brush.SubtleSelected}" />
                        </Trigger>
                        <Trigger Property="IsWindowActive" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon button for the title bar and sidebar (on Mica). Always set AutomationProperties.Name. -->
    <Style x:Key="Button.Chrome" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SubtleSelected}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
      Title-bar toggle (e.g. "show notifications"): looks like Button.Chrome and stays highlighted while
      what it opens is visible. Bind IsChecked OneWay to that state and toggle it through Command:
      WPF sets the click's own toggle as a current value, so the binding is kept. Screen readers get
      the toggle state for free.
    -->
    <Style x:Key="ToggleButton.Chrome" TargetType="ToggleButton" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SubtleSelected}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SubtleSelected}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Looks like a search box, behaves like a button that opens the command palette. -->
    <Style x:Key="Button.SearchField" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.SubtleSelected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="10,0,6,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar navigation -->
    <Style x:Key="Nav.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter Margin="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nav.Item" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Small}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <StackPanel>
                        <!-- Section label and its compact-mode replacement: decoration, not clickable. -->
                        <TextBlock x:Name="GroupHeader" Style="{StaticResource Text.Overline}" Margin="12,18,0,6" IsHitTestVisible="False"
                                   Text="{TemplateBinding ui:NavAssist.GroupHeader}" />
                        <Border x:Name="CompactDivider" Height="1" Margin="10,12,10,10" Background="{DynamicResource Brush.Border}"
                                IsHitTestVisible="False" Visibility="Collapsed" />
                        <Grid MinHeight="{TemplateBinding MinHeight}" Margin="0,1" Background="Transparent">
                            <Border x:Name="Bg" CornerRadius="{StaticResource Radius.Medium}" Background="Transparent" />
                            <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource Brush.AccentText}" Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:NavAssist.IsCompact" Value="True">
                            <Setter TargetName="GroupHeader" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CompactDivider" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ui:NavAssist.GroupHeader" Value="{x:Null}">
                            <Setter TargetName="GroupHeader" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CompactDivider" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.SubtleSelected}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter Property="FontWeight" Value="Medium" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
