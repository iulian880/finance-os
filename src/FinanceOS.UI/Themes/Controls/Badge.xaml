<!-- Badge (FinanceOS.UI.Controls.Badge): pill label in one of six tones, optional status dot. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:FinanceOS.UI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="ui:Badge">
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextTertiary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Badge">
                    <!-- BorderBrush carries the dot color; the badge itself has no outline. -->
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Full}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Fill="{TemplateBinding BorderBrush}" Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowDot" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tone" Value="Accent">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="Tone" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessText}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
            </Trigger>
            <Trigger Property="Tone" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
            </Trigger>
            <Trigger Property="Tone" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
            </Trigger>
            <Trigger Property="Tone" Value="Info">
                <Setter Property="Background" Value="{DynamicResource Brush.InfoSubtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.InfoText}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
