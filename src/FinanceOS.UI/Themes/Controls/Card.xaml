<!-- Card, EmptyState and Skeleton: static content surfaces. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:FinanceOS.UI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="ui:Card">
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Card">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Large}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="HeaderRow" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" RecognizesAccessKey="True"
                                                      TextElement.FontSize="{StaticResource FontSize.Subheading}" TextElement.FontWeight="SemiBold" />
                                    <TextBlock x:Name="DescriptionText" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="{TemplateBinding Description}" />
                                </StackPanel>
                                <ContentPresenter x:Name="ActionsPresenter" Grid.Column="1" Margin="12,-6,-8,-6" VerticalAlignment="Center"
                                                  Content="{TemplateBinding Actions}" />
                            </Grid>
                            <ContentPresenter Grid.Row="1" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Actions" Value="{x:Null}">
                            <Setter TargetName="ActionsPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasHeader" Value="False" />
                                <Condition Property="Description" Value="{x:Null}" />
                                <Condition Property="Actions" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:EmptyState">
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="24,40" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:EmptyState">
                    <StackPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" MaxWidth="420">
                        <Border x:Name="IconBadge" Width="56" Height="56" Margin="0,0,0,16" HorizontalAlignment="Center"
                                CornerRadius="{StaticResource Radius.Full}" Background="{DynamicResource Brush.SurfaceSunken}">
                            <ui:Icon Data="{TemplateBinding Icon}" Size="24" Foreground="{DynamicResource Brush.TextSecondary}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TitleText" Style="{StaticResource Text.Subheading}" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="{TemplateBinding Title}" />
                        <TextBlock x:Name="DescriptionText" Style="{StaticResource Text.Secondary}" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,6,0,0" Text="{TemplateBinding Description}" />
                        <ContentPresenter x:Name="Actions" Margin="0,20,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconBadge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Skeleton: block in the shape of the content it replaces. Sweep is started/stopped by code. -->
    <Style TargetType="ui:Skeleton">
        <Setter Property="Height" Value="12" />
        <Setter Property="Background" Value="{DynamicResource Brush.Skeleton}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Skeleton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                        <Border x:Name="PART_Shimmer" HorizontalAlignment="Left" Visibility="Collapsed">
                            <Border.Background>
                                <!-- Edges use the block color itself, so the sweep has no visible seam. -->
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Offset="0" Color="{DynamicResource Color.Skeleton}" />
                                    <GradientStop Offset="0.5" Color="{DynamicResource Color.SkeletonHighlight}" />
                                    <GradientStop Offset="1" Color="{DynamicResource Color.Skeleton}" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
