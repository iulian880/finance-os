<!--
  TextField = TextBox (implicit style) + ui:FieldAssist.Header / Placeholder / HelperText / ErrorText.
  Box: hairline outline plus a stronger bottom stroke, so the input boundary reaches 3:1 (WCAG 1.4.11)
  without heavy borders. Focus: outline and a 2 px bottom stroke in the focus color.
  TextBox.Multiline for notes and descriptions.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:FinanceOS.UI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="Header" Style="{StaticResource Field.HeaderText}"
                                   Text="{TemplateBinding ui:FieldAssist.Header}" />

                        <Grid x:Name="Box" Grid.Row="1" MinHeight="{TemplateBinding MinHeight}">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Radius.Medium}" />
                            <Border x:Name="Underline" BorderBrush="{DynamicResource Brush.ControlStrongStroke}"
                                    BorderThickness="0,0,0,1" CornerRadius="{StaticResource Radius.Medium}" />
                            <!-- No margin here: TextBox applies Padding inside its content host itself. -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                            <Grid Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  IsHitTestVisible="False">
                                <!-- 2 px: the text view's own inset, so placeholder and text line up. -->
                                <TextBlock x:Name="Placeholder" Style="{StaticResource Field.PlaceholderText}" Margin="2,0"
                                           Text="{TemplateBinding ui:FieldAssist.Placeholder}" />
                            </Grid>
                        </Grid>

                        <TextBlock x:Name="Helper" Grid.Row="2" Style="{StaticResource Field.MessageText}"
                                   Text="{TemplateBinding ui:FieldAssist.HelperText}" />
                        <TextBlock x:Name="Error" Grid.Row="2" Style="{StaticResource Field.ErrorText}" Visibility="Collapsed"
                                   Text="{TemplateBinding ui:FieldAssist.ErrorText}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:FieldAssist.Header" Value="{x:Null}">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ui:FieldAssist.Header" Value="">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ui:FieldAssist.HelperText" Value="{x:Null}">
                            <Setter TargetName="Helper" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="Box" Property="IsMouseOver" Value="True" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                                <Condition Property="IsReadOnly" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
                            <Setter TargetName="Underline" Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                            <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                            <Setter TargetName="Underline" Property="BorderThickness" Value="0,0,0,2" />
                        </Trigger>
                        <Trigger Property="ui:FieldAssist.HasError" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="Helper" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Error" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                            <Setter TargetName="Underline" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Header" Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextBox.Multiline" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinLines" Value="3" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

</ResourceDictionary>
