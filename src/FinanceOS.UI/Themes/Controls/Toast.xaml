<!-- ToastHost: in-app notifications, bottom-right. Templates for ToastMessage items. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:FinanceOS.UI.Controls"
                    xmlns:loc="clr-namespace:FinanceOS.UI.Localization">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Toast.ActionButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <DataTemplate x:Key="Toast.ItemTemplate" DataType="{x:Type ui:ToastMessage}">
        <Border Width="360" Margin="0,8,0,0" Padding="14,12,8,12" CornerRadius="{StaticResource Radius.Large}"
                Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                Effect="{DynamicResource Effect.Elevation2}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Icon x:Name="ToneIcon" Size="20" Margin="0,0,12,0" VerticalAlignment="Top"
                         Data="{StaticResource Icon.Info}" Foreground="{DynamicResource Brush.InfoText}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.BodyStrong}" TextWrapping="Wrap" TextTrimming="None" Text="{Binding Title}" />
                    <TextBlock x:Name="MessageText" Style="{StaticResource Text.Small}" Foreground="{DynamicResource Brush.TextSecondary}"
                               TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" Text="{Binding Message}" />
                    <Button x:Name="ActionButton" Style="{StaticResource Toast.ActionButton}" HorizontalAlignment="Left" Margin="-8,6,0,0"
                            Content="{Binding ActionText}" Command="{x:Static ui:ToastHost.RunActionCommand}" CommandParameter="{Binding}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="28" Height="28" MinHeight="28" Margin="8,-4,0,0"
                        VerticalAlignment="Top" AutomationProperties.Name="{loc:Tr Ui.Dismiss}"
                        Command="{x:Static ui:ToastHost.DismissCommand}" CommandParameter="{Binding}">
                    <ui:Icon Data="{StaticResource Icon.X}" Size="16" />
                </Button>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:ToastTone.Success}">
                <Setter TargetName="ToneIcon" Property="Data" Value="{StaticResource Icon.CircleCheck}" />
                <Setter TargetName="ToneIcon" Property="Foreground" Value="{DynamicResource Brush.SuccessText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:ToastTone.Warning}">
                <Setter TargetName="ToneIcon" Property="Data" Value="{StaticResource Icon.TriangleAlert}" />
                <Setter TargetName="ToneIcon" Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static ui:ToastTone.Danger}">
                <Setter TargetName="ToneIcon" Property="Data" Value="{StaticResource Icon.CircleAlert}" />
                <Setter TargetName="ToneIcon" Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ActionText}" Value="{x:Null}">
                <Setter TargetName="ActionButton" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style TargetType="ui:ToastHost">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:ToastHost">
                    <!-- Margin: room for the toast shadows; the host itself is only as large as its toasts. -->
                    <ItemsControl x:Name="PART_Items" Margin="24,16,24,24" Focusable="False"
                                  ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}"
                                  ItemTemplate="{StaticResource Toast.ItemTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
