<!--
  CheckBox (implicit style): 18 px box, accent fill when checked, minus glyph when indeterminate.
  Toggle (x:Key="Toggle", TargetType CheckBox): on/off switch for settings that apply immediately.
  The switch reuses CheckBox so it keeps the Toggle automation pattern and Space-to-toggle.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FinanceOS.UI;component/Themes/Controls/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="CheckBox.Base" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlStrongStroke}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Small}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBox.Base}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <Viewbox Width="12" Height="12">
                                <Path x:Name="Glyph" Style="{StaticResource Glyph.Path}" StrokeThickness="3"
                                      Stroke="{DynamicResource Brush.OnAccent}" Data="{StaticResource Icon.Check}" Visibility="Collapsed" />
                            </Viewbox>
                        </Border>
                        <ContentPresenter x:Name="Content" Grid.Column="1" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Icon.Minus}" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Brush.TextTertiary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Toggle" TargetType="CheckBox" BasedOn="{StaticResource CheckBox.Base}">
        <Setter Property="IsThreeState" Value="False" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Pill}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" BorderThickness="1"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="5,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource Brush.TextSecondary}" />
                        </Border>
                        <ContentPresenter x:Name="Content" Grid.Column="1" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            <Setter TargetName="Thumb" Property="Width" Value="14" />
                            <Setter TargetName="Thumb" Property="Height" Value="14" />
                            <Setter TargetName="Thumb" Property="Margin" Value="4,0" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Brush.OnAccent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Brush.TextTertiary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
